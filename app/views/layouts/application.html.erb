<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Avenue Code Forecast" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Avenue Code Forecast">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <main class="container">
      <header>
        <h1><a href="<%= root_path %>">Avenue Code Forecast</a></h1>
      </header>

      <% flash.each do |level, message| %>
        <div class="flash flash-<%= level %>" role="alert"><%= message %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
